PREFIX altr-ext: <http://www.w3.org/ns/dx/connegp/altr-ext#>
PREFIX atns: <https://linked.data.gov.au/def/atns/model/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shext: <http://example.com/shacl-extension#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# The workbench includes project-oriented profiles used during IDN catalogue
# development. They are examples and local test configuration, not a claim that
# these profiles are part of Prez itself.
prez:CustomIndexProfile a prof:Profile, prez:IndexProfile ;
  dcterms:identifier "workbench"^^xsd:token ; dcterms:title "Prez Workbench Index Profile"@en ;
  dcterms:description "Selects dataset, ATNS, ODRL and RiC-O presentation profiles while retaining Prez defaults."@en ;
  altr-ext:constrainsClass prez:CatPrez ; altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
  altr-ext:hasNodeShape
    [ a sh:NodeShape ; sh:targetClass schema:Dataset ; altr-ext:hasDefaultProfile prez:DatasetProfile ],
    [ a sh:NodeShape ; sh:targetClass odrl:Agreement ; altr-ext:hasDefaultProfile prez:OdrlAgreementProfile ],
    [ a sh:NodeShape ; sh:targetClass atns:Entity ; altr-ext:hasDefaultProfile prez:AtnsEntityProfile ],
    [ a sh:NodeShape ; sh:targetClass rico:RecordSet ; altr-ext:hasDefaultProfile prez:RiCORecordSetProfile ],
    [ a sh:NodeShape ; sh:targetClass rico:Record ; altr-ext:hasDefaultProfile prez:RiCORecordProfile ] ;
  altr-ext:hasResourceFormat "application/json", "application/ld+json", "application/rdf+xml", "text/anot+turtle", "text/turtle" .

prez:DatasetProfile
    a prof:Profile, prez:ObjectProfile, sh:NodeShape ;
    dcterms:identifier "dataset"^^xsd:token ;
    dcterms:title "Dataset presentation profile"@en ;
    dcterms:description "Presents common dataset metadata while retaining provenance statements in the underlying RDF."@en ;
    altr-ext:constrainsClass schema:Dataset ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json",
        "application/ld+json",
        "application/rdf+xml",
        "text/anot+turtle",
        "text/turtle" ;
    sh:property [
        sh:path [
            sh:union (
                rdf:type
                dcterms:source
                owl:imports
                schema:citation
                schema:conditionsOfAccess
                schema:creator
                schema:dateCreated
                schema:dateModified
                schema:description
                schema:license
                schema:name
                schema:publisher
            )
        ]
    ] .

prez:AtnsEntityProfile
    a prof:Profile, prez:ObjectProfile, sh:NodeShape ;
    dcterms:identifier "atns-entity"^^xsd:token ;
    dcterms:title "ATNS Entity presentation profile"@en ;
    dcterms:description "Presents an ATNS entity with embedded reference metadata, spatial feature details and, when present on the same resource, reviewed ODRL Agreement obligations and targets, while omitting source deletion flags."@en ;
    altr-ext:constrainsClass atns:Entity ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat "application/anot+ld+json", "application/ld+json", "text/anot+turtle", "text/turtle" ;
    sh:property [
        sh:path [
            sh:union (
                shext:allPredicateValues
                ( schema:spatialCoverage rdf:type )
                ( schema:spatialCoverage schema:name )
                ( schema:spatialCoverage schema:description )
                ( schema:spatialCoverage geo:hasGeometry )
                ( schema:spatialCoverage geo:hasGeometry geo:asWKT )
                ( schema:spatialCoverage geo:hasBoundingBox )
                ( schema:spatialCoverage geo:hasBoundingBox geo:asWKT )
                ( dcterms:references schema:author )
                ( dcterms:references schema:datePublished )
                ( dcterms:references schema:name )
                ( dcterms:references schema:url )
                ( odrl:obligation rdf:type )
                ( odrl:obligation dcterms:title )
                ( odrl:obligation schema:name )
                ( odrl:obligation schema:description )
                ( odrl:obligation schema:citation )
                ( odrl:obligation skos:editorialNote )
                ( odrl:obligation odrl:action )
                ( odrl:obligation odrl:action skos:prefLabel )
                ( odrl:obligation odrl:assigner )
                ( odrl:obligation odrl:assigner schema:name )
                ( odrl:obligation odrl:assignee )
                ( odrl:obligation odrl:assignee schema:name )
                ( odrl:obligation odrl:target )
                ( odrl:obligation odrl:target rdf:type )
                ( odrl:obligation odrl:target schema:name )
                ( odrl:obligation odrl:target schema:description )
            )
        ]
    ],
    [
        sh:maxCount 0 ;
        sh:path atns:deleted ;
    ] .

prez:OdrlAgreementEmbeddedPropertyShape
    a sh:PropertyShape ;
    schema:name "Embedded ODRL Agreement structure"@en ;
    sh:path [
        sh:union (
            shext:allPredicateValues
            ( odrl:permission rdf:type )
            ( odrl:permission dcterms:title )
            ( odrl:permission schema:name )
            ( odrl:permission schema:description )
            ( odrl:permission schema:citation )
            ( odrl:permission odrl:action )
            ( odrl:permission odrl:assigner )
            ( odrl:permission odrl:assignee )
            ( odrl:permission odrl:target )
            ( odrl:permission odrl:duty )
            ( odrl:permission odrl:duty rdf:type )
            ( odrl:permission odrl:duty schema:name )
            ( odrl:permission odrl:duty schema:description )
            ( odrl:permission odrl:duty schema:citation )
            ( odrl:permission odrl:duty skos:editorialNote )
            ( odrl:permission odrl:duty odrl:action )
            ( odrl:permission odrl:duty odrl:assigner )
            ( odrl:permission odrl:duty odrl:assignee )
            ( odrl:permission odrl:duty odrl:target )
            ( odrl:prohibition rdf:type )
            ( odrl:prohibition schema:name )
            ( odrl:prohibition schema:description )
            ( odrl:prohibition schema:citation )
            ( odrl:prohibition odrl:action )
            ( odrl:prohibition odrl:assigner )
            ( odrl:prohibition odrl:assignee )
            ( odrl:prohibition odrl:target )
            ( odrl:obligation rdf:type )
            ( odrl:obligation dcterms:title )
            ( odrl:obligation schema:name )
            ( odrl:obligation schema:description )
            ( odrl:obligation schema:citation )
            ( odrl:obligation skos:editorialNote )
            ( odrl:obligation odrl:action )
            ( odrl:obligation odrl:action rdf:type )
            ( odrl:obligation odrl:action schema:name )
            ( odrl:obligation odrl:action skos:prefLabel )
            ( odrl:obligation odrl:action skos:definition )
            ( odrl:obligation odrl:assigner )
            ( odrl:obligation odrl:assigner rdf:type )
            ( odrl:obligation odrl:assigner schema:name )
            ( odrl:obligation odrl:assigner schema:alternateName )
            ( odrl:obligation odrl:assigner schema:url )
            ( odrl:obligation odrl:assigner schema:provider )
            ( odrl:obligation odrl:assigner schema:hasPart )
            ( odrl:obligation odrl:assigner schema:hasPart rdf:type )
            ( odrl:obligation odrl:assigner schema:hasPart schema:name )
            ( odrl:obligation odrl:assigner schema:hasPart schema:alternateName )
            ( odrl:obligation odrl:assigner schema:hasPart schema:url )
            ( odrl:obligation odrl:assignee )
            ( odrl:obligation odrl:assignee rdf:type )
            ( odrl:obligation odrl:assignee schema:name )
            ( odrl:obligation odrl:assignee schema:alternateName )
            ( odrl:obligation odrl:assignee schema:url )
            ( odrl:obligation odrl:assignee schema:provider )
            ( odrl:obligation odrl:assignee schema:hasPart )
            ( odrl:obligation odrl:assignee schema:hasPart rdf:type )
            ( odrl:obligation odrl:assignee schema:hasPart schema:name )
            ( odrl:obligation odrl:assignee schema:hasPart schema:alternateName )
            ( odrl:obligation odrl:assignee schema:hasPart schema:url )
            ( odrl:obligation odrl:target )
            ( odrl:obligation odrl:target rdf:type )
            ( odrl:obligation odrl:target schema:name )
            ( odrl:obligation odrl:target schema:description )
            ( odrl:obligation odrl:target geo:hasGeometry )
            ( odrl:obligation odrl:target geo:hasGeometry geo:asWKT )
            ( odrl:obligation odrl:target geo:hasBoundingBox )
            ( odrl:obligation odrl:target geo:hasBoundingBox geo:asWKT )
        )
    ] ;
.

prez:OdrlAgreementProfile
    a prof:Profile, prez:ObjectProfile, sh:NodeShape ;
    dcterms:identifier "odrl-agreement"^^xsd:token ;
    dcterms:title "ODRL Agreement presentation profile"@en ;
    dcterms:description "Presents an ODRL Agreement with its named Permission rules, actions, parties, targets and available target geometry."@en ;
    altr-ext:constrainsClass odrl:Agreement ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json",
        "application/ld+json",
        "text/anot+turtle",
        "text/turtle" ;
    sh:property prez:OdrlAgreementEmbeddedPropertyShape .

prez:RiCORecordSetProfile
    a prof:Profile, prez:ObjectProfile, sh:NodeShape ;
    dcterms:identifier "rico-record-set"^^xsd:token ;
    dcterms:title "RiC-O Record Set presentation profile"@en ;
    dcterms:description "Presents a RiC-O Record Set using preferred schema.org fields and RiC-O archival detail."@en ;
    altr-ext:constrainsClass rico:RecordSet ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json",
        "application/ld+json",
        "application/rdf+xml",
        "text/anot+turtle",
        "text/turtle" ;
    sh:property [
        sh:path [
            sh:union (
                rdf:type
                dcterms:contributor
                dcterms:creator
                schema:additionalType
                schema:conditionsOfAccess
                schema:creator
                schema:dateCreated
                schema:dateModified
                schema:description
                schema:identifier
                schema:inLanguage
                schema:location
                schema:materialExtent
                schema:name
                schema:publisher
                schema:usageInfo
                rico:hasContentOfType
                rico:hasDocumentaryFormType
                ( rico:isAssociatedWithDate rico:expressedDate )
            )
        ]
    ] .

prez:RiCORecordProfile
    a prof:Profile, prez:ObjectProfile, sh:NodeShape ;
    dcterms:identifier "rico-record"^^xsd:token ;
    dcterms:title "RiC-O Record presentation profile"@en ;
    dcterms:description "Presents a RiC-O Record using preferred schema.org fields, one generic instantiation relationship, and expressed dates."@en ;
    altr-ext:constrainsClass rico:Record ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json",
        "application/ld+json",
        "application/rdf+xml",
        "text/anot+turtle",
        "text/turtle" ;
    sh:property [
        sh:path [
            sh:union (
                rdf:type
                dcterms:contributor
                dcterms:creator
                schema:conditionsOfAccess
                schema:creator
                schema:dateCreated
                schema:dateModified
                schema:description
                schema:identifier
                schema:inLanguage
                schema:location
                schema:materialExtent
                schema:name
                schema:publisher
                schema:usageInfo
                rico:hasContentOfType
                rico:hasDocumentaryFormType
                rico:hasOrHadInstantiation
                ( rico:hasOrHadInstantiation rdf:type )
                ( rico:hasOrHadInstantiation schema:name )
                ( rico:hasOrHadInstantiation schema:description )
                ( rico:hasOrHadInstantiation schema:identifier )
                ( rico:hasOrHadInstantiation schema:location )
                ( rico:hasOrHadInstantiation schema:materialExtent )
                ( rico:hasOrHadInstantiation schema:dateCreated )
                ( rico:hasOrHadInstantiation schema:dateModified )
                ( rico:hasOrHadInstantiation rico:instantiationExtent )
                ( rico:hasOrHadInstantiation rico:hasCollector )
                ( rico:hasOrHadInstantiation rico:isAssociatedWithDate rico:expressedDate )
                ( rico:isAssociatedWithDate rico:expressedDate )
                rico:isOrWasIncludedIn
            )
        ]
    ] .
