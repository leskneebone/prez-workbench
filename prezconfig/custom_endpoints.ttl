@prefix atns: <https://linked.data.gov.au/def/atns/model/> .
@prefix ex: <https://example.org/prez-workbench/> .
@prefix ont: <https://prez.dev/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:catalogs-listing a ont:DynamicEndpoint, ont:ListingEndpoint ; rdfs:label "Catalogs Listing" ; ont:apiPath "/catalogs" ; ont:relevantShapes ex:catalog-shape .
ex:catalogs-object a ont:DynamicEndpoint, ont:ObjectEndpoint ; rdfs:label "Catalog Object" ; ont:apiPath "/catalogs/{catalogId}" ; ont:relevantShapes ex:catalog-shape .
ex:collections-listing a ont:DynamicEndpoint, ont:ListingEndpoint ; rdfs:label "Collections Listing" ; ont:apiPath "/catalogs/{catalogId}/collections" ; ont:relevantShapes ex:collection-shape .
ex:collections-object a ont:DynamicEndpoint, ont:ObjectEndpoint ; rdfs:label "Collection Object" ; ont:apiPath "/catalogs/{catalogId}/collections/{collectionId}" ; ont:relevantShapes ex:collection-shape .
ex:items-listing a ont:DynamicEndpoint, ont:ListingEndpoint ; rdfs:label "Items Listing" ; ont:apiPath "/catalogs/{catalogId}/collections/{collectionId}/items" ; ont:relevantShapes ex:item-shape .
ex:items-object a ont:DynamicEndpoint, ont:ObjectEndpoint ; rdfs:label "Item Object" ; ont:apiPath "/catalogs/{catalogId}/collections/{collectionId}/items/{itemId}" ; ont:relevantShapes ex:item-shape .

ex:catalog-shape a sh:NodeShape ;
  sh:targetClass schema:DataCatalog ;
  sh:property [
    sh:path schema:hasPart
  ] ;
  ont:hierarchyLevel 1 .
# Collections may be schema:Dataset resources or archival rico:RecordSet
# resources used by the included project examples.
ex:collection-shape a sh:NodeShape ; sh:targetClass schema:Dataset, rico:RecordSet ; ont:hierarchyLevel 2 ; sh:property [ sh:class schema:DataCatalog ; sh:path [ sh:inversePath schema:hasPart ] ] .
# The schema:isPartOf bridge lets one route shape navigate generic CreativeWork,
# ATNS and RiC-O examples without competing endpoint definitions.
ex:item-shape a sh:NodeShape ; sh:targetClass schema:CreativeWork, atns:Entity, rico:Record ; ont:hierarchyLevel 3 ;
  sh:property
    [ sh:class schema:DataCatalog ; sh:path ( schema:isPartOf [ sh:inversePath schema:hasPart ] ) ],
    [ sh:path schema:isPartOf ] .
